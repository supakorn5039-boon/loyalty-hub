# Application Port & Secrets
PORT=8080
APP_SECRET=change-this-to-a-secure-random-jwt-secret-key

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=loyalty_user
POSTGRES_PASSWORD=loyalty_password_super_secret_2026
POSTGRES_DB=loyaltyhub_db

# Redis In-Memory Token Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Vendor Custom Branding & Points Rules
COMPANY_NAME=Rewardly Co.
APP_DISPLAY_NAME=LoyaltyHub
POINTS_PER_CURRENCY_SPENT=0.10 # 1 Point per 10 Baht/USD
